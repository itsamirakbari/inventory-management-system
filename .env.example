# InventoryPro local configuration
# Copy this file to .env and replace every placeholder with a local value.

# MySQL 8 connection
# The schema includes users, categories, suppliers, products, customers,
# invoices, invoice items, and inventory transactions.
MYSQL_HOST=localhost
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password
MYSQL_DATABASE=inventory_management_system

# Flask session signing key
# Generate a strong value, for example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_key

# SMTP settings used for account verification, password reset, and email changes
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_google_app_password
MAIL_USE_TLS=True
